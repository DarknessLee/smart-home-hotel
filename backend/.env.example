# ---------------------------------------------------------------------------
# 智慧住家（Smart Home Hotel）Go 后端环境变量示例
#
# 使用方式：
#   cp .env.example .env
#   go run ./cmd/server
#
# 说明：internal/config/config.go 内置了一个极简 .env 解析器（仅标准库），
# 进程真实环境变量优先级高于 .env 文件；生产环境建议直接用容器/K8s 注入环境变量。
# ---------------------------------------------------------------------------

# 运行环境：development / staging / production
APP_ENV=development

# HTTP 监听端口（默认 8080，完整地址为 :<HTTP_PORT>）
HTTP_PORT=8080

# Gin 运行模式：debug / release / test
GIN_MODE=debug

# CORS 允许来源（逗号分隔，* 表示全部允许；Mock/联调阶段默认全部允许）
CORS_ALLOW_ORIGINS=*

# ---------------------------------------------------------------------------
# 以下配置为「后期替换点」占位：当前内存仓库（internal/store/memory.go）不会读取，
# 接入真实中间件时在 internal/store 中替换实现即可。
# ---------------------------------------------------------------------------

# MySQL（替换内存仓库）
MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/smart_home_hotel?charset=utf8mb4&parseTime=True&loc=Local

# Redis（替换登录态 / 设备属性缓存）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# EMQX / MQTT（设备属性下发，见 internal/iot/mqtt.go 扩展点）
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TEMPLATE=hotel/{store_id}/room/{room_id}/device/{device_id}/command
