{
  "name": "智慧住家",
  "appid": "",
  "description": "智慧住家 · C 端顾客端（uni-app + Vue3 + 纯 JavaScript）",
  "versionName": "0.1.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
